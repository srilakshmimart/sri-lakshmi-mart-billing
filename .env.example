# ============================================================
# Sri Lakshmi Mart — Admin & Billing
#
# This is a static front end, so it has no build step and cannot
# read a .env file at runtime. These values are recorded here for
# your deployment platform and for whoever sets the project up;
# the two public ones are copied into js/config.js.
# ============================================================

# --- safe in the browser (public, protected by Row Level Security) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# --- NEVER put these in js/config.js or any client file ---
# Only for server-side scripts, migrations or scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
